# Groq (console.groq.com/keys) — usado por src/lib/llm.ts para todas as chamadas
# estruturadas do pipeline (Roteirista, Marketing, Persuasão, Compliance geral,
# correção) e também para a transcrição via Whisper na Ingestão
# (src/core/ingestion/whisper.ts). Cota diária de tokens (TPD) — ao estourar,
# cai automaticamente no fallback pra OpenAI (ver OPENAI_FALLBACK_MODEL abaixo).
GROQ_API_KEY=
# Opcional — só se usar um endpoint compatível com Groq que não seja o oficial.
GROQ_BASE_URL=
# Opcional — teto usado só pra estimar quando avisar no console (não é limite
# real, é o que a Groq relata como TPD). Default: 200000 (src/lib/cost-tracker.ts).
GROQ_DAILY_TOKEN_BUDGET=

# OpenAI (platform.openai.com/api-keys) — peça paga do núcleo. Usada pra: leitura
# visual dos frames na Ingestão (analyze.ts), foto do ator/produto (actor-vision.ts,
# product-vision.ts), Teólogo, Psicologia de Compra e Copyright (julgamento fino,
# não é checagem mecânica) — e como fallback de TODO o resto quando a Groq estoura
# cota (src/lib/llm.ts).
OPENAI_API_KEY=
# Opcional — endpoint compatível com OpenAI, se não for a API oficial.
OPENAI_BASE_URL=
# Modelo usado só no fallback quando a Groq estoura cota. Default: "gpt-5".
OPENAI_FALLBACK_MODEL=

# Supabase — persiste temas salvos e histórico de gerações (src/lib/supabase.ts).
# Projeto compartilhado com outro app (Klebercdc's Project) — as tabelas
# creator_saved_themes/creator_history e o bucket creator-reference-videos
# são isolados e não tocam no resto do outro produto.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mesmo projeto/chave acima, só que expostos ao navegador (prefixo
# KRONIA_PUBLIC_ — configurado em vite.config.ts `envPrefix` pra ir pro
# bundle do cliente, no lugar do VITE_ padrão do Vite: o Vercel reconhece
# VITE_ como "prefixo público de framework" e trava o Save de uma env var
# sensível com esse prefixo, sem opção clara de resolver no app mobile).
# Usados só pra upload direto do vídeo de referência pro bucket
# creator-reference-videos (src/lib/supabase-client.ts) quando o usuário
# grava a própria tela em vez de colar um link — o bucket é privado e a
# policy de RLS restringe a chave anon a insert/select/delete só nesse
# bucket, nada além disso.
KRONIA_PUBLIC_SUPABASE_URL=
KRONIA_PUBLIC_SUPABASE_ANON_KEY=

# yt-dlp/ffmpeg/ffprobe (Caminho A via link — src/core/ingestion/{download,
# frames,whisper}.ts) são baixados sob demanda pra /tmp em runtime
# (src/lib/vendored-binary.ts), não dependem de nada pré-instalado no
# Vercel. Quando o link não funciona (bloqueio da plataforma, etc.), o
# usuário tem o fallback de enviar um arquivo de vídeo direto (ex: gravação
# de tela) via upload — não depende de baixar de lugar nenhum.
