# Groq (console.groq.com/keys) — usado por src/lib/llm.ts para todas as chamadas
# estruturadas do pipeline (Classificação, Recomendação, Geração, Compliance) e
# também para a transcrição via Whisper na Ingestão (src/core/ingestion/whisper.ts).
GROQ_API_KEY=

# OpenAI (platform.openai.com/api-keys) — única peça paga do núcleo, usada
# SÓ para a leitura visual dos frames na Ingestão (src/core/ingestion/analyze.ts),
# porque a Groq não tem modelo com visão no catálogo atual.
OPENAI_API_KEY=
