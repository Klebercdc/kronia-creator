# OpenAI (platform.openai.com/api-keys) — provider único do KRONIA (src/lib/openai.ts).
# Usada por todo o pipeline estruturado (Roteirista, Marketing, Persuasão, Psicologia
# de Compra, Cinematográfico, SEO, Compliance, correção, Opportunity Engine, Trend
# Interpreter), pela leitura visual dos frames na Ingestão e fotos de ator/produto, e
# pela transcrição de áudio (Whisper) quando o vídeo de referência não tem legenda.
# Groq foi removido: a cota diária gratuita se esgotava em uso normal (não só em
# escala), e isso exigia um caminho de fallback pra OpenAI que tinha um bug de schema
# próprio — dois providers pra manter, metade da confiabilidade.
OPENAI_API_KEY=
# Opcional — endpoint compatível com OpenAI, se não for a API oficial.
OPENAI_BASE_URL=

# Supabase — persiste temas salvos e histórico de gerações (src/lib/supabase.ts).
# Projeto compartilhado com outro app (Klebercdc's Project) — as tabelas
# creator_saved_themes/creator_history e o bucket creator-reference-videos
# são isolados e não tocam no resto do outro produto.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mesmo projeto/chave acima, só que expostos ao navegador (prefixo VITE_ —
# vai pro bundle do cliente pelo comportamento padrão do Vite). Usados só
# pra upload direto do vídeo de referência pro bucket
# creator-reference-videos (src/lib/supabase-client.ts) quando o usuário
# grava a própria tela em vez de colar um link — o bucket é privado e a
# policy de RLS restringe a chave anon a insert/select/delete só nesse
# bucket, nada além disso. No Vercel, uma env var com esse prefixo pode
# pedir confirmação extra pra salvar (ele reconhece VITE_ como prefixo
# público de framework) — não é erro, é só o Vercel confirmando que a
# exposição ao navegador é intencional.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# yt-dlp/ffmpeg/ffprobe (Caminho A via link — src/core/ingestion/{download,
# frames,whisper}.ts) são baixados sob demanda pra /tmp em runtime
# (src/lib/vendored-binary.ts), não dependem de nada pré-instalado no
# Vercel. Quando o link não funciona (bloqueio da plataforma, etc.), o
# usuário tem o fallback de enviar um arquivo de vídeo direto (ex: gravação
# de tela) via upload — não depende de baixar de lugar nenhum.

# Segredo do worker do Job Engine (src/routes/api/jobs/worker.ts) —
# protege o endpoint que avança a Ingestão de vídeo em background. Só duas
# coisas devem conhecer esse valor: a env var do Vercel (server-side,
# nunca prefixo VITE_/público) e o job do pg_cron no Supabase (migration
# creator_jobs_worker_cron, roda dentro do Postgres, nunca chega ao
# navegador). Gere com: openssl rand -hex 24
CRON_SECRET=
